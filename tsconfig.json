{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "rootDir": "./",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "allowJs": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,

    "types": ["node"]
  },

  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "dist"]
}
